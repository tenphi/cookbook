---
import { ConsumerGlobalStyles, SiteTitleRoot } from "./site-title.js";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<ConsumerGlobalStyles />
<SiteTitleRoot href={siteTitleHref} className="consumer-title">
  <svg
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
    fill="currentColor"
  >
    <path d="M12 2 22 12 12 22 2 12Z"></path>
  </svg>
  <span translate="no">{siteTitle}</span>
</SiteTitleRoot>
<span class="consumer-global"><span>Docs</span></span>
