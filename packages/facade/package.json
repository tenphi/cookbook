{
  "name": "@tenphi/cookbook",
  "version": "0.9.1",
  "description": "Repository-native static documentation for Astro",
  "type": "module",
  "keywords": [
    "astro-integration",
    "astro",
    "documentation",
    "starlight",
    "static-site"
  ],
  "bin": {
    "cookbook": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenphi/cookbook.git",
    "directory": "packages/facade"
  },
  "homepage": "https://github.com/tenphi/cookbook#readme",
  "bugs": {
    "url": "https://github.com/tenphi/cookbook/issues"
  },
  "author": "Andrey Yamanov",
  "license": "MIT",
  "dependencies": {
    "@tenphi/docs": "workspace:*",
    "@tenphi/starlight": "workspace:*",
    "jiti": "^2.6.1"
  },
  "peerDependencies": {
    "astro": "catalog:"
  },
  "devDependencies": {
    "astro": "catalog:",
    "@types/node": "^22.15.2",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
