{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasty.style/schemas/cookbook.schema.json",
  "title": "Cookbook configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "favicon": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source"],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "background": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "head": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag"],
        "properties": {
          "tag": {
            "type": "string"
          },
          "attrs": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "boolean"]
            }
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "editLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl"],
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "lastUpdated": {
      "type": "boolean",
      "default": false
    },
    "locales": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/locale"
      }
    },
    "defaultLocale": {
      "type": "string"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowOutsideRoot": {
          "type": "boolean",
          "default": false
        },
        "localizeRepositoryLinks": {
          "type": "boolean",
          "default": false
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "frontmatter": {
          "enum": ["preserve", "reject"],
          "default": "preserve"
        }
      }
    },
    "navigation": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/navigationItem"
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/navigationItem"
              }
            },
            "tabs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/navigationTab"
              }
            }
          }
        }
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brand": {},
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "surface": {},
            "text": {},
            "textSoft": {},
            "info": {},
            "success": {},
            "warning": {},
            "danger": {}
          }
        },
        "states": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tokens": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(\\$|--)[a-zA-Z0-9_-]+$"
          },
          "additionalProperties": {
            "type": ["string", "number"]
          }
        },
        "presets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/typographyPreset"
          }
        },
        "styles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Card": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Callout": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "CodeGroup": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Tab": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Footer": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Hero": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "LanguageSelect": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Logo": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "MarkdownCodeBlock": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "MarkdownHeading": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "MarkdownTable": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Mermaid": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "MobileMenuFooter": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "MobileMenuToggle": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "MobileNavigationTabs": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "MobileTableOfContents": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "PackageVersion": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Preview": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Sidebar": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Steps": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Tabs": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "TableOfContents": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "ThemeSelect": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "TopNavigation": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "StarlightHeader": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "MarkdownInlineCode": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "SocialIcons": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            }
          }
        },
        "contrastLevel": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          ]
        },
        "customStyles": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "not": {
                "const": "mode"
              }
            }
          }
        }
      }
    },
    "markdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stripLeadingBadges": {
          "type": "boolean",
          "default": true
        },
        "rawHtml": {
          "enum": ["allow", "sanitize", "strip", "reject"],
          "default": "sanitize"
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overrides": {
          "type": "object",
          "properties": {
            "Footer": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "const": false
                }
              ]
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strict": {
          "type": "boolean",
          "default": true
        },
        "ci": {
          "type": "boolean"
        },
        "cacheDir": {
          "type": "string"
        },
        "maxArtifactBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxUnpackedBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxFiles": {
          "type": "integer",
          "minimum": 1
        },
        "maxPathDepth": {
          "type": "integer",
          "minimum": 1
        },
        "maxAssetBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "root": {
      "type": "string"
    },
    "redirects": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": {
          "type": "string"
        },
        "lang": {
          "type": "string"
        },
        "dir": {
          "enum": ["ltr", "rtl"]
        }
      }
    },
    "navigationItem": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "items"],
          "properties": {
            "label": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/navigationItem"
              }
            },
            "link": {
              "type": "string",
              "pattern": "^/(?!/)[^?#\\\\\\s]*$",
              "description": "Optional parent page route, without a deployment base, query, or fragment.",
              "not": {
                "pattern": "//|(^|/)\\.{1,2}(/|$)"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "autogenerate"],
          "properties": {
            "label": {
              "type": "string"
            },
            "autogenerate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["directory"],
              "properties": {
                "directory": {
                  "type": "string"
                }
              }
            },
            "link": {
              "type": "string",
              "pattern": "^/(?!/)[^?#\\\\\\s]*$",
              "description": "Optional parent page route, without a deployment base, query, or fragment.",
              "not": {
                "pattern": "//|(^|/)\\.{1,2}(/|$)"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "link"],
          "properties": {
            "label": {
              "type": "string"
            },
            "link": {
              "type": "string"
            }
          }
        }
      ]
    },
    "navigationTab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "link"],
      "properties": {
        "label": {
          "type": "string"
        },
        "link": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/navigationItem"
          }
        }
      }
    },
    "typographyPreset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontFamily": {
          "type": "string"
        },
        "fontSize": {
          "type": ["string", "number"]
        },
        "lineHeight": {
          "type": ["string", "number"]
        },
        "letterSpacing": {
          "type": ["string", "number"]
        },
        "fontWeight": {
          "type": ["string", "number"]
        },
        "boldFontWeight": {
          "type": ["string", "number"]
        },
        "iconSize": {
          "type": ["string", "number"]
        },
        "textTransform": {
          "type": ["string", "number"]
        },
        "fontStyle": {
          "type": ["string", "number"]
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "route": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "navigation": {
              "oneOf": [
                {
                  "const": false
                },
                {
                  "$ref": "#/$defs/navigationPlacement"
                }
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "routeBase": {
              "type": "string"
            },
            "root": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["glob"],
          "properties": {
            "glob": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "base": {
              "type": "string"
            },
            "routeBase": {
              "type": "string"
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "navigation": {
              "enum": ["auto", false]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "root": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["package"],
          "properties": {
            "package": {
              "type": "string",
              "minLength": 1
            },
            "include": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "index": {
              "type": "string"
            },
            "routeBase": {
              "type": "string"
            },
            "trust": {
              "enum": ["markdown", "mdx"]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "registry": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      ]
    },
    "navigationPlacement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "order": {
          "type": "number"
        },
        "group": {
          "type": "string"
        }
      }
    }
  }
}
