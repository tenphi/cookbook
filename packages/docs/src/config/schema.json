{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasty.style/schemas/cookbook.schema.json",
  "title": "Cookbook configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "version": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "repository": { "type": "string", "format": "uri" },
        "favicon": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source"],
              "properties": {
                "source": { "type": "string", "minLength": 1 },
                "background": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      }
    },
    "head": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag"],
        "properties": {
          "tag": { "type": "string" },
          "attrs": {
            "type": "object",
            "additionalProperties": { "type": ["string", "boolean"] }
          },
          "content": { "type": "string" }
        }
      }
    },
    "editLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl"],
      "properties": { "baseUrl": { "type": "string", "format": "uri" } }
    },
    "lastUpdated": { "type": "boolean", "default": false },
    "locales": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/locale" }
    },
    "defaultLocale": { "type": "string" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowOutsideRoot": { "type": "boolean", "default": false },
        "localizeRepositoryLinks": { "type": "boolean", "default": false },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
      }
    },
    "navigation": {
      "oneOf": [
        {
          "type": "array",
          "items": { "$ref": "#/$defs/navigationItem" }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "items": { "$ref": "#/$defs/navigationItem" }
            },
            "tabs": {
              "type": "array",
              "items": { "$ref": "#/$defs/navigationTab" }
            }
          }
        }
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant": { "type": "string" },
        "brand": {},
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "surface": {},
            "text": {},
            "textSoft": {}
          }
        },
        "states": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tokens": {
          "type": "object",
          "propertyNames": { "pattern": "^(\\$|--)[a-zA-Z0-9_-]+$" },
          "additionalProperties": { "type": ["string", "number"] }
        },
        "presets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/typographyPreset" }
        },
        "styles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "propertyNames": { "not": { "const": "mode" } }
          }
        },
        "contrastLevel": {
          "oneOf": [
            { "const": "auto" },
            { "type": "number", "minimum": 0, "maximum": 100 }
          ]
        }
      }
    },
    "markdown": { "type": "object" },
    "search": { "type": "object" },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overrides": {
          "type": "object",
          "properties": {
            "Footer": {
              "oneOf": [{ "type": "string" }, { "const": false }]
            }
          },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "build": { "type": "object" }
  },
  "$defs": {
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string" },
        "lang": { "type": "string" },
        "dir": { "enum": ["ltr", "rtl"] }
      }
    },
    "navigationItem": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "items"],
          "properties": {
            "label": { "type": "string" },
            "items": {
              "type": "array",
              "items": { "$ref": "#/$defs/navigationItem" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "autogenerate"],
          "properties": {
            "label": { "type": "string" },
            "autogenerate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["directory"],
              "properties": { "directory": { "type": "string" } }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "link"],
          "properties": {
            "label": { "type": "string" },
            "link": { "type": "string" }
          }
        }
      ]
    },
    "navigationTab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "link"],
      "properties": {
        "label": { "type": "string" },
        "link": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/navigationItem" }
        }
      }
    },
    "typographyPreset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontFamily": { "type": "string" },
        "fontSize": { "type": ["string", "number"] },
        "lineHeight": { "type": ["string", "number"] },
        "letterSpacing": { "type": ["string", "number"] },
        "fontWeight": { "type": ["string", "number"] },
        "boldFontWeight": { "type": ["string", "number"] },
        "iconSize": { "type": ["string", "number"] },
        "textTransform": { "type": ["string", "number"] },
        "fontStyle": { "type": ["string", "number"] }
      }
    },
    "source": {
      "type": "object",
      "oneOf": [
        { "required": ["file"] },
        { "required": ["glob"] },
        { "required": ["package"] }
      ]
    }
  }
}
