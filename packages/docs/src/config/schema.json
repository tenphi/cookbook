                  "const": "mode"
                }
              }
            },
            "CodeGroup": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Tab": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Footer": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Hero": {
