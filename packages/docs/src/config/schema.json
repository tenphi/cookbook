{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasty.style/schemas/tasty-docs.schema.json",
  "title": "Tasty Docs configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "repository": { "type": "string", "format": "uri" }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowOutsideRoot": { "type": "boolean", "default": false },
        "localizeRepositoryLinks": { "type": "boolean", "default": false },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
      }
    },
    "navigation": { "type": ["object", "array"] },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant": { "type": "string" },
        "brand": {},
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "surface": {},
            "text": {},
            "textSoft": {}
          }
        },
        "states": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tokens": {
          "type": "object",
          "propertyNames": { "pattern": "^(\\$|--)[a-zA-Z0-9_-]+$" },
          "additionalProperties": { "type": ["string", "number"] }
        },
        "presets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/typographyPreset" }
        },
        "styles": { "type": "object" },
        "contrastLevel": {
          "oneOf": [
            { "const": "auto" },
            { "type": "number", "minimum": 0, "maximum": 100 }
          ]
        }
      }
    },
    "markdown": { "type": "object" },
    "search": { "type": "object" },
    "components": { "type": "object" },
    "build": { "type": "object" }
  },
  "$defs": {
    "typographyPreset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontFamily": { "type": "string" },
        "fontSize": { "type": ["string", "number"] },
        "lineHeight": { "type": ["string", "number"] },
        "letterSpacing": { "type": ["string", "number"] },
        "fontWeight": { "type": ["string", "number"] },
        "boldFontWeight": { "type": ["string", "number"] },
        "iconSize": { "type": ["string", "number"] },
        "textTransform": { "type": ["string", "number"] },
        "fontStyle": { "type": ["string", "number"] }
      }
    },
    "source": {
      "type": "object",
      "oneOf": [
        { "required": ["file"] },
        { "required": ["glob"] },
        { "required": ["package"] }
      ]
    }
  }
}
