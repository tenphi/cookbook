                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000
                      },
                      {
                        "type": "string",
                        "pattern": "^(?:[1-9][0-9]{0,2}|1000) (?:[1-9][0-9]{0,2}|1000)$"
