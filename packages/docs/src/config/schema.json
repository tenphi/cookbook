  "$defs": {
    "brandColor": {
      "description": "A Glaze from declaration for the brand seed, optionally with APCA targets. Literal shorthand and structured hue, saturation, and tone are also supported.",
      "oneOf": [
        {
          "$ref": "#/$defs/glazeColorValue"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from"],
          "properties": {
            "from": {
              "$ref": "#/$defs/glazeColorValue"
            },
            "contrast": {
              "$ref": "#/$defs/brandContrast"
            },
            "unsafeContrast": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["hue", "saturation", "tone"],
          "properties": {
            "hue": {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            },
            "saturation": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "tone": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "contrast": {
              "$ref": "#/$defs/brandContrast"
            },
            "unsafeContrast": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "brandContrast": {
