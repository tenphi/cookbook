              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "HeaderLinks": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Layout": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "SearchButton": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "TableOfContentsLayout": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "PageFrame": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "PageActions": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "contrastLevel": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          ]
        },
        "customStyles": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "not": {
                "const": "mode"
              }
            }
          }
        }
      }
    },
    "markdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stripLeadingBadges": {
          "type": "boolean",
          "default": true
        },
        "rawHtml": {
          "enum": ["allow", "sanitize", "strip", "reject"],
          "default": "sanitize"
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
