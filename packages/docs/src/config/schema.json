            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["src"],
                "properties": {
                  "src": {
                    "type": "string",
                    "pattern": "^/(?!/).+\\.(woff2?|ttf|otf)$"
