              "maximum": 100
            },
            "hi": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "eps": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    },
    "paletteColor": {
      "description": "A Glaze color declaration; literal colors are convenient seed shorthands.",
