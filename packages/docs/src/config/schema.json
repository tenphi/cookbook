                }
              }
            },
            "SiteLogo": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Logo": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "MarkdownCodeBlock": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "MarkdownHeading": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "MarkdownTable": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Mermaid": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "MobileMenuFooter": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "MobileMenuToggle": {
              "type": "object",
              "propertyNames": {
