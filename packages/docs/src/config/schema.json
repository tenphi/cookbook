    "themeFont": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["google"],
          "properties": {
            "google": {
              "type": "string",
              "minLength": 1
            },
            "weights": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  {
                    "type": "string",
                    "pattern": "^(?:[1-9][0-9]{0,2}|1000) (?:[1-9][0-9]{0,2}|1000)$"
                  }
                ]
              }
            },
            "styles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": ["normal", "italic"]
              }
