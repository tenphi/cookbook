{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasty.style/schemas/cookbook.schema.json",
  "title": "Cookbook configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "versions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "routeBase"],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "routeBase": {
                "type": "string",
                "pattern": "^/(?!/)"
              },
              "index": {
                "type": "boolean"
              }
            }
          }
        },
        "description": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "logo": {
          "oneOf": [
            {
              "const": false
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "additionalProperties": false,
              "oneOf": [
                {
                  "required": ["src"],
                  "not": {
                    "anyOf": [
                      {
                        "required": ["light"]
                      },
                      {
                        "required": ["dark"]
                      }
                    ]
                  }
                },
                {
                  "required": ["light", "dark"],
                  "not": {
                    "required": ["src"]
                  }
                }
              ],
              "properties": {
                "src": {
                  "type": "string",
                  "minLength": 1
                },
                "light": {
                  "type": "string",
                  "minLength": 1
                },
                "dark": {
                  "type": "string",
                  "minLength": 1
                },
                "alt": {
                  "type": "string"
                },
                "href": {
                  "type": "string"
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "decorative": {
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "favicon": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source"],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "background": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "headerLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "link"],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "link": {
                "type": "string",
                "pattern": "^(?:https?://[^\\s\\\\]+|/(?!/)[^\\s\\\\]*|#[^\\s\\\\]*)$"
              },
              "variant": {
                "enum": ["default", "primary"]
              },
              "newTab": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "seo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "titleTemplate": {
              "type": "string",
              "pattern": "\\{title\\}"
            },
            "image": {
              "oneOf": [
                {
                  "const": false
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["src", "alt"],
                  "properties": {
                    "src": {
                      "type": "string"
                    },
                    "alt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              ]
            },
            "index": {
              "type": "boolean"
            },
            "breadcrumbs": {
              "type": "boolean"
            },
            "copyPage": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "head": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag"],
        "properties": {
          "tag": {
            "type": "string"
          },
          "attrs": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "boolean"]
            }
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "editLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl"],
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "lastUpdated": {
      "type": "boolean",
      "default": false
    },
    "locales": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/locale"
      }
    },
    "translations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "defaultLocale": {
      "type": "string"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowOutsideRoot": {
          "type": "boolean",
          "default": false
        },
        "localizeRepositoryLinks": {
          "type": "boolean",
          "default": false
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "frontmatter": {
          "enum": ["preserve", "reject"],
          "default": "preserve"
        }
      }
    },
    "navigation": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/navigationItem"
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/navigationItem"
              }
            },
            "tabs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/navigationTab"
              }
            }
          }
        }
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brand": {
          "$ref": "#/$defs/brandColor"
        },
        "palette": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?:textSoft|[a-z][a-z0-9]*(?:-[a-z0-9]+)*)$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/paletteColor"
          },
          "properties": {
            "surface-2": {
              "$ref": "#/$defs/paletteColor"
            },
            "surface-3": {
              "$ref": "#/$defs/paletteColor"
            },
            "text-soft": {
              "$ref": "#/$defs/paletteColor"
            },
            "text-muted": {
              "$ref": "#/$defs/paletteColor"
            },
            "sidebar-text": {
              "$ref": "#/$defs/paletteColor"
            },
            "surface-2-hover": {
              "$ref": "#/$defs/paletteColor"
            },
            "surface-2-pressed": {
              "$ref": "#/$defs/paletteColor"
            },
            "surface-3-hover": {
              "$ref": "#/$defs/paletteColor"
            },
            "surface-3-pressed": {
              "$ref": "#/$defs/paletteColor"
            },
            "accent-text": {
              "$ref": "#/$defs/paletteColor"
            },
            "focus": {
              "$ref": "#/$defs/paletteColor"
            },
            "accent-surface": {
              "$ref": "#/$defs/paletteColor"
            },
            "accent-surface-text": {
              "$ref": "#/$defs/paletteColor"
            },
            "logo-surface": {
              "$ref": "#/$defs/paletteColor"
            },
            "logo-mark": {
              "$ref": "#/$defs/paletteColor"
            },
            "accent-surface-subtle": {
              "$ref": "#/$defs/paletteColor"
            },
            "accent-surface-2-subtle": {
              "$ref": "#/$defs/paletteColor"
            },
            "shadow": {
              "$ref": "#/$defs/paletteColor"
            },
            "clear": {
              "$ref": "#/$defs/paletteColor"
            },
            "info-text": {
              "$ref": "#/$defs/paletteColor"
            },
            "info-surface": {
              "$ref": "#/$defs/paletteColor"
            },
            "success-text": {
              "$ref": "#/$defs/paletteColor"
            },
            "success-surface": {
              "$ref": "#/$defs/paletteColor"
            },
            "warning-text": {
              "$ref": "#/$defs/paletteColor"
            },
            "warning-surface": {
              "$ref": "#/$defs/paletteColor"
            },
            "danger-text": {
              "$ref": "#/$defs/paletteColor"
            },
            "danger-surface": {
              "$ref": "#/$defs/paletteColor"
            },
            "orange": {
              "$ref": "#/$defs/paletteColor"
            },
            "orange-text": {
              "$ref": "#/$defs/paletteColor"
            },
            "orange-surface": {
              "$ref": "#/$defs/paletteColor"
            },
            "green": {
              "$ref": "#/$defs/paletteColor"
            },
            "green-text": {
              "$ref": "#/$defs/paletteColor"
            },
            "green-surface": {
              "$ref": "#/$defs/paletteColor"
            },
            "blue": {
              "$ref": "#/$defs/paletteColor"
            },
            "blue-text": {
              "$ref": "#/$defs/paletteColor"
            },
            "blue-surface": {
              "$ref": "#/$defs/paletteColor"
            },
            "purple": {
              "$ref": "#/$defs/paletteColor"
            },
            "purple-text": {
              "$ref": "#/$defs/paletteColor"
            },
            "purple-surface": {
              "$ref": "#/$defs/paletteColor"
            },
            "red": {
              "$ref": "#/$defs/paletteColor"
            },
            "red-text": {
              "$ref": "#/$defs/paletteColor"
            },
            "red-surface": {
              "$ref": "#/$defs/paletteColor"
            },
            "border": {
              "$ref": "#/$defs/paletteColor"
            },
            "border-strong": {
              "$ref": "#/$defs/paletteColor"
            },
            "syntax-bg": {
              "$ref": "#/$defs/paletteColor"
            },
            "syntax-text": {
              "$ref": "#/$defs/paletteColor"
            },
            "syntax-comment": {
              "$ref": "#/$defs/paletteColor"
            },
            "syntax-punctuation": {
              "$ref": "#/$defs/paletteColor"
            },
            "syntax-keyword": {
              "$ref": "#/$defs/paletteColor"
            },
            "syntax-string": {
              "$ref": "#/$defs/paletteColor"
            },
            "syntax-token": {
              "$ref": "#/$defs/paletteColor"
            },
            "syntax-property": {
              "$ref": "#/$defs/paletteColor"
            },
            "syntax-number": {
              "$ref": "#/$defs/paletteColor"
            },
            "syntax-function": {
              "$ref": "#/$defs/paletteColor"
            },
            "syntax-value": {
              "$ref": "#/$defs/paletteColor"
            },
            "syntax-operator": {
              "$ref": "#/$defs/paletteColor"
            },
            "surface": {
              "$ref": "#/$defs/paletteColor"
            },
            "text": {
              "$ref": "#/$defs/paletteColor"
            },
            "heading": {
              "$ref": "#/$defs/paletteColor"
            },
            "textSoft": {
              "$ref": "#/$defs/paletteColor"
            },
            "info": {
              "$ref": "#/$defs/paletteColor"
            },
            "success": {
              "$ref": "#/$defs/paletteColor"
            },
            "warning": {
              "$ref": "#/$defs/paletteColor"
            },
            "danger": {
              "$ref": "#/$defs/paletteColor"
            },
            "header": {
              "$ref": "#/$defs/paletteColor"
            },
            "overlay": {
              "$ref": "#/$defs/paletteColor"
            }
          }
        },
        "units": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "recipes": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "not": {
              "const": "none"
            }
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "not": {
                "pattern": "^[A-Z&.]"
              }
            },
            "not": {
              "required": ["recipe"]
            }
          }
        },
        "glaze": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lightTone": {
              "$ref": "#/$defs/toneWindow"
            },
            "darkTone": {
              "$ref": "#/$defs/toneWindow"
            },
            "darkDesaturation": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "autoFlip": {
              "type": "boolean"
            },
            "pastel": {
              "type": "boolean"
            },
            "inferRole": {
              "type": "boolean"
            },
            "shadowTuning": {
              "type": "object"
            }
          }
        },
        "fontLoading": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "google": {
              "enum": ["self-hosted", "remote"]
            },
            "cache": {
              "enum": ["reuse", "refresh", "offline"]
            },
            "display": {
              "enum": ["auto", "block", "swap", "fallback", "optional"]
            }
          }
        },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "body": {
              "$ref": "#/$defs/themeFont"
            },
            "heading": {
              "$ref": "#/$defs/themeFont"
            },
            "code": {
              "$ref": "#/$defs/themeFont"
            }
          }
        },
        "states": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tokens": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(\\$|--)[a-zA-Z0-9_-]+$"
          },
          "additionalProperties": {
            "type": ["string", "number"]
          }
        },
        "presets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/typographyPreset"
          }
        },
        "styles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Document": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "MainPane": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "MainContent": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Banner": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "SkipLink": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Search": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Pagination": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Markdown": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "MermaidSource": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "MarkdownAlert": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "SyntaxHighlight": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "SearchResults": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Card": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "mode"
                }
              }
            },
            "Callout": {
              "type": "object",
              "propertyNames": {
