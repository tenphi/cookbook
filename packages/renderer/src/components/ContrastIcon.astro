---
interface Props {
  level: "normal" | "more";
}

const { level } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  <circle
    cx="12"
    cy="12"
    r="8"
    fill="none"
    stroke="currentColor"
    stroke-width="2"></circle>
  {
    level === "more" ? (
      <path d="M12 4a8 8 0 0 0 0 16Z" fill="currentColor" />
    ) : (
      <path d="M12 4v16" fill="none" stroke="currentColor" stroke-width="2" />
    )
  }
</svg>
