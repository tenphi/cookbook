---
import Icon from "./Icon.astro";

interface Option {
  href: string;
  label: string;
  lang?: string;
  hint?: string;
  current?: boolean;
}

interface Props {
  triggerLabel: string;
  selectedLabel: string;
  title: string;
  options: Option[];
  icon?: string;
}

const { triggerLabel, selectedLabel, title, options, icon } = Astro.props;
const id = `select-${crypto.randomUUID()}`;
---

<button
  type="button"
  popovertarget={id}
  aria-label={triggerLabel}
  title={title}
>
  {icon && <Icon name={icon} class="label-icon" />}
  <span class="trigger-label">{selectedLabel}</span>
  <Icon name="down-caret" class="caret" />
</button>
<div
  id={id}
  popover="auto"
  role="group"
  aria-label={title}
  data-select-popover-panel
>
  <div class="panel-title">{title}</div>
  <nav aria-label={title}>
    {
      options.map((option) => (
        <a
          href={option.href}
          aria-current={option.current ? "page" : undefined}
        >
          <span lang={option.lang}>{option.label}</span>
          {option.hint && <span class="fallback-label">({option.hint})</span>}
          <Icon name="approve-check" class="checkmark" />
        </a>
      ))
    }
  </nav>
</div>

<script>
  import { initializePopoverMotion } from "../client/popover-motion.js";

  document
    .querySelectorAll<HTMLElement>("[data-select-popover-panel]")
    .forEach((panel) => initializePopoverMotion(panel));
</script>
