---
import Icon from "./Icon.astro";

interface Option {
  href: string;
  label: string;
  lang?: string;
  hint?: string;
  current?: boolean;
}

interface Props {
  triggerLabel: string;
  selectedLabel: string;
  title: string;
  options: Option[];
  icon?: string;
  /** UniAria owns behavior when rendered inside a cb-popover host. */
  managed?: boolean;
}

const {
  triggerLabel,
  selectedLabel,
  title,
  options,
  icon,
  managed = false,
} = Astro.props;
const id = `select-${crypto.randomUUID()}`;
---

<button
  type="button"
  popovertarget={managed ? undefined : id}
  data-uni-part={managed ? "popover-trigger" : undefined}
  aria-label={triggerLabel}
  title={title}
>
  {icon && <Icon name={icon} data-element="LabelIcon" />}
  <span data-element="TriggerLabel">{selectedLabel}</span>
  <Icon name="down-caret" data-element="Caret" />
</button>
<div
  id={id}
  data-element="Panel"
  popover={managed ? "manual" : "auto"}
  data-uni={managed ? "popover" : undefined}
  role="group"
  aria-label={title}
  data-select-popover-panel={managed ? undefined : ""}
>
  <div data-element="PanelTitle">{title}</div>
  <nav aria-label={title}>
    {
      options.map((option) => (
        <a
          href={option.href}
          aria-current={option.current ? "page" : undefined}
        >
          <span lang={option.lang}>{option.label}</span>
          {option.hint && <span data-element="Fallback">({option.hint})</span>}
          <Icon name="approve-check" data-element="Checkmark" />
        </a>
      ))
    }
  </nav>
</div>

<script>
  import { initializePopoverMotion } from "../client/popover-motion.js";

  const initialized = new WeakSet<HTMLElement>();
  function initialize(): void {
    document
      .querySelectorAll<HTMLElement>("[data-select-popover-panel]")
      .forEach((panel) => {
        if (initialized.has(panel)) return;
        initialized.add(panel);
        initializePopoverMotion(panel);
      });
  }
  initialize();
  document.addEventListener("astro:page-load", initialize);
</script>
