---
import { content } from "virtual:cookbook/config";
import Logo from "./Logo.astro";
import { SiteLogoRoot } from "./SiteLogo.styles.js";
const logo = content.logo;
---

{
  logo === false ? null : logo ? (
    <SiteLogoRoot aria-hidden={logo.decorative ? "true" : undefined}>
      <img
        data-element={logo.dark ? "Light" : undefined}
        src={logo.light.src}
        width={logo.light.width}
        height={logo.light.height}
        alt={logo.decorative ? "" : logo.alt}
        decoding="async"
      />
      {logo.dark && (
        <img
          data-element="Dark"
          src={logo.dark.src}
          width={logo.dark.width}
          height={logo.dark.height}
          alt={logo.decorative ? "" : logo.alt}
          decoding="async"
        />
      )}
    </SiteLogoRoot>
  ) : (
    <Logo decorative />
  )
}
