---
import {
  localizedNavigation,
  localePath,
  localeHref,
} from "../localization.js";
import { messages } from "../localization.js";
import { content } from "virtual:cookbook/config";
import { layout as configuredLayout } from "virtual:cookbook/layout";
import { activeNavigationTab, navigationPath } from "../navigation.js";
import { MobileNavigationTabsRoot } from "./MobileNavigationTabs.styles.js";
import SelectPopover from "./SelectPopover.astro";

interface Props {
  base?: string;
  currentPath: string;
}

const { base = "/", currentPath } = Astro.props;
const basePath = base === "/" ? "" : `/${base.replace(/^\/+|\/+$/g, "")}`;
const { layout } = localizedNavigation(
  configuredLayout,
  content.routes,
  navigationPath(currentPath, base),
  content,
);
const activeTab = activeNavigationTab(
  layout.tabs,
  localePath(navigationPath(currentPath, basePath || "/"), content),
);

function tabHref(link: string): string {
  return localeHref(
    link,
    navigationPath(currentPath, base),
    content.routes,
    content,
    base,
  );
}
const ui = messages(Astro.locals.cookbookRoute?.lang ?? "en", content);
---

{
  layout.tabs.length > 0 && (
    <MobileNavigationTabsRoot
      className="td-mobile-tabs"
      data-print-hidden=""
      non-modal=""
      focus-on-open="false"
    >
      <SelectPopover
        managed
        triggerLabel={ui.chooseSection}
        selectedLabel={layout.tabs[activeTab]?.label ?? ui.sections}
        title={ui.sections}
        options={layout.tabs.map((tab, index) => ({
          href: tabHref(tab.link),
          label: tab.label,
          current: index === activeTab,
        }))}
      />
    </MobileNavigationTabsRoot>
  )
}

<script>
  // The section selector is mobile-only. Keep the behavior runtime out of
  // desktop page loads, including when a reader later narrows the viewport.
  const mobile = matchMedia("(width < 50rem)");
  const initialize = () => {
    if (
      mobile.matches &&
      document.querySelector(
        "cookbook-popover[data-element=MobileNavigationTabs]",
      )
    )
      void import("../client/elements.js");
  };
  mobile.addEventListener("change", initialize);
  document.addEventListener("astro:page-load", initialize);
  initialize();
</script>
