---
const { lang, lastUpdated } = Astro.locals.cookbookRoute;
---

{
  lastUpdated && (
    <p>
      {Astro.locals.t("page.lastUpdated")}{" "}
      <time datetime={lastUpdated.toISOString()}>
        {lastUpdated.toLocaleDateString(lang, {
          dateStyle: "medium",
          timeZone: "UTC",
        })}
      </time>
    </p>
  )
}
