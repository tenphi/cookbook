---
import { LogoRoot } from "./Logo.styles.js";

import type { LogoProps as Props } from "./props.js";

const {
  label = "Cookbook",
  decorative = false,
  class: className,
} = Astro.props;
---

<LogoRoot className={className} aria-hidden={decorative ? "true" : undefined}>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 64 64"
    role={decorative ? undefined : "img"}
    aria-label={decorative ? undefined : label}
    focusable="false"
  >
    <rect width="64" height="64" rx="14" fill="currentColor"></rect>
    <path
      data-element="Mark"
      fill="currentColor"
      d="M14.8 16c6.7.2 12.3 2 16.7 5.4v28.4c-4.4-3.1-10-4.7-16.6-4.9a3 3 0 0 1-2.9-3V19a3 3 0 0 1 2.8-3Z"
    ></path>
    <path
      data-element="Mark"
      fill="currentColor"
      d="M49.2 16c-6.7.2-12.3 2-16.7 5.4v28.4c4.4-3.1 10-4.7 16.6-4.9a3 3 0 0 0 2.9-3V19a3 3 0 0 0-2.8-3Z"
    ></path>
  </svg>
</LogoRoot>
