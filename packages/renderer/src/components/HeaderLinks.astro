---
import { messages } from "../localization.js";
import { localeHref, routeLocale } from "../localization.js";
import { navigationPath } from "../navigation.js";
import { content } from "virtual:cookbook/config";
import { HeaderLinksRoot } from "./HeaderLinks.styles.js";

const links = content.site.headerLinks ?? [];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = navigationPath(Astro.url.pathname, base || "/");
const href = (link: string) =>
  localeHref(link, currentPath, content.routes, content, base || "/");
const locale = routeLocale(currentPath, content);
const language =
  content.locales?.[locale]?.lang ?? (locale === "root" ? "en" : locale);
const label = (value: string) =>
  content.translations?.[language]?.[`navigation.${value}`] ??
  content.translations?.[language.split("-")[0]!]?.[`navigation.${value}`] ??
  value;
const ui = messages(Astro.locals.cookbookRoute?.lang ?? "en", content);
---

{
  links.length > 0 && (
    <HeaderLinksRoot>
      <nav class="td-header-links__desktop" aria-label={ui.headerLinks}>
        {links.map((link) => (
          <a
            href={href(link.link)}
            data-variant={link.variant}
            target={link.newTab ? "_blank" : undefined}
            rel={link.newTab ? "noopener noreferrer" : undefined}
          >
            {label(link.label)}
          </a>
        ))}
      </nav>
      <button
        type="button"
        class="td-header-links__trigger"
        popovertarget="cookbook-header-links"
        aria-label={ui.more}
        title={ui.more}
      >
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          aria-hidden="true"
          fill="currentColor"
        >
          <>
            <circle cx="12" cy="5" r="2" />
            <circle cx="12" cy="12" r="2" />
            <circle cx="12" cy="19" r="2" />
          </>
        </svg>
      </button>
      <div
        id="cookbook-header-links"
        popover="auto"
        class="td-header-links__panel"
      >
        <button
          type="button"
          class="td-header-links__close"
          popovertarget="cookbook-header-links"
          popovertargetaction="hide"
          aria-label={ui.closeMore}
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path
              d="m6 6 12 12M6 18 18 6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
        </button>
        <nav aria-label={ui.moreLinks}>
          {links.map((link) => (
            <a
              href={href(link.link)}
              target={link.newTab ? "_blank" : undefined}
              rel={link.newTab ? "noopener noreferrer" : undefined}
            >
              {label(link.label)}
            </a>
          ))}
        </nav>
      </div>
    </HeaderLinksRoot>
  )
}
