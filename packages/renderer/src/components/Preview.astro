---
import { messages, requestLanguage } from "../localization.js";
import { content } from "virtual:cookbook/config";
import { PreviewRoot } from "./Preview.styles.js";

import type { PreviewProps as Props } from "./props.js";

const { title, html = "", css = "", javascript } = Astro.props;
const source = `<!doctype html><meta charset="utf-8"><style>${css}</style>${html}${javascript ? `<script>${javascript}<\/script>` : ""}`;
const ui = messages(
  requestLanguage(Astro.url.pathname, content.base, content),
  content,
);
---

<PreviewRoot className="td-preview" data-not-content="" aria-label={title}>
  <PreviewRoot.Caption><strong>{title}</strong></PreviewRoot.Caption>
  <PreviewRoot.Stage>
    <PreviewRoot.Frame
      title={title}
      sandbox={javascript ? "allow-scripts" : ""}
      srcDoc={source}
    />
  </PreviewRoot.Stage>
  <PreviewRoot.Code>
    <PreviewRoot.Summary>{ui.viewSource}</PreviewRoot.Summary>
    <PreviewRoot.Pre><code>{source}</code></PreviewRoot.Pre>
  </PreviewRoot.Code>
</PreviewRoot>
