---
import { messages, requestLanguage } from "../localization.js";
import { buildPreview } from "../preview-document.js";
import { content } from "virtual:cookbook/config";
import { PreviewRoot, previewHeightStyles } from "./Preview.styles.js";

import type { PreviewProps as Props } from "./props.js";

const { title } = Astro.props;
const preview = await buildPreview(
  Astro.props,
  content.publicDir,
  Astro.url.pathname,
);
const ui = messages(
  requestLanguage(Astro.url.pathname, content.base, content),
  content,
);
---

<PreviewRoot
  className="td-preview"
  data-not-content=""
  aria-label={title}
  styles={preview.height && previewHeightStyles(preview.height)}
>
  <PreviewRoot.Caption><strong>{title}</strong></PreviewRoot.Caption>
  <PreviewRoot.Stage>
    <PreviewRoot.Frame
      title={title}
      sandbox={preview.sandbox}
      srcDoc={preview.document}
      data-buffer={preview.buffer}
    />
  </PreviewRoot.Stage>
  <PreviewRoot.Code>
    <PreviewRoot.Summary>{ui.viewSource}</PreviewRoot.Summary>
    <PreviewRoot.Pre><code>{preview.source}</code></PreviewRoot.Pre>
  </PreviewRoot.Code>
</PreviewRoot>

<script>
  import { initializePreviewHeight } from "../client/preview-height.js";

  initializePreviewHeight();
</script>
