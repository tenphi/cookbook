---
import { TabsRoot } from "./TastyComponents.js";
import type { TabsProps as Props } from "./props.js";
const { label = "Examples" } = Astro.props;
---

<TabsRoot data-cookbook-tabs aria-label={label}>
  <TabsRoot.List data-tabs-list />
  <slot />
</TabsRoot>

<script>
  import { initializeTabs } from "../client/tabs.js";
  initializeTabs();
  document.addEventListener("astro:page-load", initializeTabs);
</script>
