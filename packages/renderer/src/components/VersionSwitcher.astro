---
import { messages } from "../localization.js";
import { content } from "virtual:cookbook/config";
import type { DocsRoute, SiteVersion } from "@tenphi/docs";
import { versionLinks } from "../versioning.js";
import { VersionSwitcherRoot } from "./LayoutComponents.js";
import SelectPopover from "./SelectPopover.astro";

interface Props {
  versions: SiteVersion[];
  routes: DocsRoute[];
  currentPath: string;
  base: string;
}

const { current, links } = versionLinks(
  Astro.props.versions,
  Astro.props.routes,
  Astro.props.currentPath,
  Astro.props.base,
  content,
);
const ui = messages(Astro.locals.cookbookRoute?.lang ?? "en", content);
---

<VersionSwitcherRoot data-tasty-anatomy="VersionSwitcher">
  <SelectPopover
    triggerLabel={`${ui.documentationVersion}: ${current?.label ?? ui.versions}`}
    selectedLabel={current?.label ?? ui.versions}
    title={ui.documentationVersions}
    options={links.map((version) => ({
      href: version.href,
      label: version.label,
      current: version.routeBase === current?.routeBase,
    }))}
  />
</VersionSwitcherRoot>
