---
import type { DocsHeading } from "@tenphi/docs";
import { content } from "virtual:cookbook/config";
import { layout } from "virtual:cookbook/layout";
import { createRouteContext } from "../route-context.js";
import { uiTranslations } from "../ui.js";
import Head from "virtual:cookbook/components/Head";
import Header from "virtual:cookbook/components/Header";
import Sidebar from "virtual:cookbook/components/Sidebar";
import PageFrame from "virtual:cookbook/components/PageFrame";
import Footer from "virtual:cookbook/components/Footer";
import Hero from "virtual:cookbook/components/Hero";
import MarkdownContent from "virtual:cookbook/components/MarkdownContent";
import MobileTableOfContents from "virtual:cookbook/components/MobileTableOfContents";
import DraftContentNotice from "virtual:cookbook/components/DraftContentNotice";
import TableOfContents from "virtual:cookbook/components/TableOfContents";
import DocumentStyles from "../components/Document.styles.js";
import { SkipLinkRoot } from "../components/SkipLink.styles.js";
import { MainPaneRoot } from "../components/MainPane.styles.js";
import { MainContentRoot } from "../components/MainContent.styles.js";
import { BannerRoot } from "../components/Banner.styles.js";
import { TableOfContentsLayoutRoot } from "../components/TableOfContentsLayout.styles.js";
import { TableOfContentsRoot } from "../components/TableOfContents.styles.js";
import AppearanceInit from "../components/AppearanceInit.astro";

interface Props {
  frontmatter: Record<string, any>;
  headings: DocsHeading[];
}
const route = createRouteContext({
  pathname: Astro.url.pathname,
  frontmatter: Astro.props.frontmatter,
  headings: Astro.props.headings,
  layout,
  content,
});
Astro.locals.cookbookRoute = route;
const translations = uiTranslations(route.lang, content);
Astro.locals.t = (key: string) => translations[key] ?? key;
const { data } = route.entry;
const indexed = route.id !== "/404" && data.pagefind !== false && !data.draft;
---

<html
  lang={route.lang}
  dir={route.dir}
  data-has-sidebar={route.hasSidebar ? "" : undefined}
  data-has-toc={route.toc ? "" : undefined}
  data-has-hero={data.hero ? "" : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <AppearanceInit />
    <meta name="astro-view-transitions-enabled" content="true" />
    <meta name="astro-view-transitions-fallback" content="swap" />
    <DocumentStyles />
    <Head />
  </head>
  <body>
    <SkipLinkRoot className="cookbook-skip-link" href="#main-content"
      >{Astro.locals.t("page.skipToContent")}</SkipLinkRoot
    >
    <PageFrame>
      <Header slot="header" />
      {route.hasSidebar && <Sidebar slot="sidebar" />}
      <div>
        {
          route.toc && (
            <TableOfContentsLayoutRoot
              className="right-sidebar-container"
              data-print-hidden=""
            >
              <div data-element="Content">
                <MobileTableOfContents />
                <TableOfContentsRoot className="right-sidebar-panel">
                  <h2>{Astro.locals.t("tableOfContents.onThisPage")}</h2>
                  <nav
                    aria-label={Astro.locals.t("tableOfContents.onThisPage")}
                  >
                    <TableOfContents items={route.toc.items} />
                  </nav>
                </TableOfContentsRoot>
              </div>
            </TableOfContentsLayoutRoot>
          )
        }
        <MainPaneRoot className="main-pane">
          <MainContentRoot
            id="main-content"
            tabIndex={-1}
            data-pagefind-body={indexed ? "" : undefined}
            lang={route.entryMeta.lang}
            dir={route.entryMeta.dir}
          >
            {
              data.banner && (
                <BannerRoot
                  className="cookbook-banner"
                  set:html={data.banner.content}
                />
              )
            }
            {
              data.hero ? (
                <div data-element="Panel">
                  <div data-element="Container">
                    <Hero />
                    <MarkdownContent>
                      <slot />
                    </MarkdownContent>
                    <Footer />
                  </div>
                </div>
              ) : (
                <>
                  <div data-element="Panel">
                    <div data-element="Container">
                      <h1 id="_top" data-page-title set:html={data.title} />
                      {data.draft && <DraftContentNotice />}
                    </div>
                  </div>
                  <div data-element="Panel">
                    <div data-element="Container">
                      <MarkdownContent>
                        <slot />
                      </MarkdownContent>
                      <Footer />
                    </div>
                  </div>
                </>
              )
            }
          </MainContentRoot>
        </MainPaneRoot>
      </div>
    </PageFrame>
    <script>
      import "../client/client-navigation.js";
      import "../client/table-of-contents.js";
    </script>
  </body>
</html>
