---
import PageActions from "../components/PageActions.astro";
import { messages } from "../localization.js";
import { content } from "virtual:cookbook/config";
import EditLink from "virtual:cookbook/components/EditLink";
import LastUpdated from "virtual:cookbook/components/LastUpdated";
import Pagination from "virtual:cookbook/components/Pagination";
import { FooterRoot } from "../components/Footer.styles.js";
const ui = messages(Astro.locals.cookbookRoute?.lang ?? "en", content);
---

<FooterRoot className="td-footer">
  <div data-element="Meta">
    <EditLink />
    <LastUpdated />
  </div>
  <PageActions />
  <Pagination />
  <p data-element="Credit">
    {ui.generatedWith}{" "}
    <a data-element="CreditLink" href="https://cookbook.tenphi.me/">Cookbook</a
    >.
  </p>
</FooterRoot>
