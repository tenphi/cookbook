---
import { PageFrameRoot } from "../components/PageFrame.styles.js";
import { HeaderFrameRoot } from "../components/HeaderFrame.styles.js";
import { SidebarRoot } from "../components/Sidebar.styles.js";
const { hasSidebar } = Astro.locals.cookbookRoute;
---

<PageFrameRoot className="page" data-has-sidebar={hasSidebar ? "" : undefined}>
  <HeaderFrameRoot className="header"><slot name="header" /></HeaderFrameRoot>
  {
    hasSidebar && (
      <SidebarRoot
        className="sidebar-pane"
        id="cookbook__sidebar"
        data-print-hidden=""
        popover="auto"
        aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
        tabIndex={-1}
      >
        <nav
          data-element="Content"
          aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
        >
          <slot name="sidebar" />
        </nav>
      </SidebarRoot>
    )
  }
  <div data-element="MainFrame"><slot /></div>
</PageFrameRoot>

<script>
  import "../client/navigation.js";
</script>
