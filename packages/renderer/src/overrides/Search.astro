---
import { messages } from "../localization.js";
import { content } from "virtual:cookbook/config";
const label = Astro.locals.t("search.label");
const translations = {
  placeholder: label,
  error: messages(Astro.locals.cookbookRoute?.lang ?? "en", content)
    .searchError,
  search: Astro.locals.t("pagefind.search"),
  zero_results: Astro.locals.t("pagefind.zero_results"),
  many_results: Astro.locals.t("pagefind.many_results"),
  one_result: Astro.locals.t("pagefind.one_result"),
};
---

<site-search
  class={Astro.props.class}
  data-translations={JSON.stringify(translations)}
  data-strip-trailing-slash={import.meta.env.TRAILING_SLASH === "never" ||
    undefined}
>
  <button
    type="button"
    data-open-modal
    disabled
    aria-label={label}
    aria-keyshortcuts="Control+K"
  >
    <span aria-hidden="true">{label}</span>
    <kbd data-pending aria-hidden="true"
      ><kbd>{Astro.locals.t("search.ctrlKey")}</kbd><kbd>K</kbd></kbd
    >
  </button>
  <dialog aria-label={label}>
    <div class="dialog-frame">
      <button type="button" data-close-modal
        >{Astro.locals.t("search.cancelLabel")}</button
      >
      {
        import.meta.env.DEV ? (
          <p data-search-status dir="ltr">
            {Astro.locals.t("search.devWarning")}
          </p>
        ) : (
          <div class="search-container">
            <p data-search-status role="status" hidden />
            <div id="cookbook__search" />
          </div>
        )
      }
    </div>
  </dialog>
</site-search>
<script>
  import { initializeSearch } from "../client/search.js";
  document.querySelectorAll<HTMLElement>("site-search").forEach((element) => {
    initializeSearch(
      element,
      {},
      import.meta.env.DEV,
      import.meta.env.BASE_URL,
    );
  });
</script>
