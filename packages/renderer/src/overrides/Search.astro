---
import { messages } from "../localization.js";
import { content } from "virtual:cookbook/config";
import { SearchRoot } from "../components/Search.styles.js";
import { SearchButtonRoot } from "../components/SearchButton.styles.js";
import { SearchResultsRoot } from "../components/SearchResults.styles.js";
const label = Astro.locals.t("search.label");
const translations = {
  placeholder: label,
  error: messages(Astro.locals.cookbookRoute?.lang ?? "en", content)
    .searchError,
  search: Astro.locals.t("pagefind.search"),
  zero_results: Astro.locals.t("pagefind.zero_results"),
  many_results: Astro.locals.t("pagefind.many_results"),
  one_result: Astro.locals.t("pagefind.one_result"),
};
---

<SearchRoot
  className={Astro.props.class}
  data-search-key={`cookbook-search:${import.meta.env.BASE_URL}:${Astro.locals.cookbookRoute.lang}`}
  data-search-base={import.meta.env.BASE_URL}
  data-translations={JSON.stringify(translations)}
  data-trailing-slash={content.trailingSlash}
>
  <SearchButtonRoot
    type="button"
    data-open-modal
    disabled
    aria-label={label}
    aria-keyshortcuts="Control+K"
  >
    <span aria-hidden="true">{label}</span>
    <kbd data-pending aria-hidden="true"
      ><kbd>{Astro.locals.t("search.ctrlKey")}</kbd><kbd>K</kbd></kbd
    >
  </SearchButtonRoot>
  <dialog aria-label={label}>
    <div data-element="Frame">
      <button
        type="button"
        data-element="Close"
        data-close-modal
        aria-label={Astro.locals.t("search.cancelLabel")}></button>
      {
        import.meta.env.DEV ? (
          <p data-element="Status" data-search-status dir="ltr">
            {Astro.locals.t("search.devWarning")}
          </p>
        ) : (
          <div data-element="Container">
            <p data-element="Status" data-search-status role="status" hidden />
            <SearchResultsRoot id="cookbook__search">
              <div data-element="UI" role="search" aria-label={label}>
                <div data-element="Field">
                  <input
                    data-element="Input"
                    data-search-input
                    type="text"
                    aria-label={label}
                    placeholder={label}
                    autocapitalize="none"
                    autocomplete="off"
                    enterkeyhint="search"
                    autofocus
                  />
                  <button
                    data-element="Clear"
                    data-clear-search
                    type="button"
                    aria-label={Astro.locals.t("pagefind.clear_search")}
                    hidden
                  />
                </div>
                <div data-element="EngineUI" data-search-results />
              </div>
            </SearchResultsRoot>
          </div>
        )
      }
    </div>
  </dialog>
</SearchRoot>
<script>
  import { initializeSearch } from "../client/search.js";
  function initialize(): void {
    document
      .querySelectorAll<HTMLElement>("cookbook-search")
      .forEach((element) => {
        if (element.dataset.searchBase !== import.meta.env.BASE_URL) return;
        initializeSearch(
          element,
          {},
          import.meta.env.DEV,
          import.meta.env.BASE_URL,
        );
      });
  }
  initialize();
  document.addEventListener("astro:page-load", initialize);
</script>
