---
import DraftContentNotice from "virtual:cookbook/components/DraftContentNotice";
import { HeroRoot } from "../components/Hero.styles.js";

const { data } = Astro.locals.cookbookRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero ?? {};
const imageAttributes = {
  loading: "eager" as const,
  decoding: "async" as const,
  fetchpriority: "high" as const,
  alt: image?.alt ?? "",
};

let darkImage: { src: string; width: number; height: number } | undefined;
let lightImage: { src: string; width: number; height: number } | undefined;
let rawHtml: string | undefined;
if (image) {
  if ("file" in image) {
    darkImage = image.file;
  } else if ("dark" in image) {
    darkImage = image.dark;
    lightImage = image.light;
  } else {
    rawHtml = image.html;
  }
}
---

<HeroRoot>
  {
    darkImage && (
      <img
        src={darkImage.src}
        width={darkImage.width}
        height={darkImage.height}
        {...imageAttributes}
        data-hero-image={lightImage ? "dark" : undefined}
      />
    )
  }
  {
    lightImage && (
      <img
        src={lightImage.src}
        width={lightImage.width}
        height={lightImage.height}
        {...imageAttributes}
        data-hero-image="light"
      />
    )
  }
  {rawHtml && <div data-element="Visual" set:html={rawHtml} />}
  <div data-element="Stack">
    <div data-element="Copy">
      <h1 id="_top" data-page-title set:html={title} />
      {data.draft && <DraftContentNotice />}
      {tagline && <div data-element="Tagline" set:html={tagline} />}
    </div>
    {
      actions.length > 0 && (
        <div data-element="Actions">
          {actions.map(({ link: href, text, variant }) => (
            <a
              {href}
              data-element="Action"
              data-primary={variant === "primary" ? "" : undefined}
              data-secondary={
                !variant || variant === "secondary" ? "" : undefined
              }
              data-minimal={variant === "minimal" ? "" : undefined}
            >
              {text}
            </a>
          ))}
        </div>
      )
    }
  </div>
</HeroRoot>
