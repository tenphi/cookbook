---
import { messages } from "../localization.js";
import { content } from "virtual:cookbook/config";
import Icon from "../components/Icon.astro";
import paletteIcon from "../icons/palette.svg?raw";
import ContrastIcon from "../components/ContrastIcon.astro";
import { ThemeSelectRoot } from "../components/ThemeSelect.styles.js";

const ui = messages(Astro.locals.cookbookRoute?.lang ?? "en", content);
const id = `appearance-${crypto.randomUUID()}`;
const schemes = [
  { value: "light", label: Astro.locals.t("themeSelect.light"), icon: "sun" },
  { value: "dark", label: Astro.locals.t("themeSelect.dark"), icon: "moon" },
  {
    value: "system",
    label: Astro.locals.t("themeSelect.auto"),
    icon: "laptop",
  },
] as const;
const contrasts = [
  { value: "normal", label: ui.normalContrast, icon: "normal" },
  { value: "more", label: ui.highContrast, icon: "more" },
  { value: "system", label: ui.auto, icon: "auto" },
] as const;
---

<ThemeSelectRoot>
  <button
    type="button"
    popovertarget={id}
    aria-label={ui.appearance}
    title={ui.appearance}
  >
    <span aria-hidden="true" set:html={paletteIcon} />
  </button>
  <div
    data-element="Panel"
    id={id}
    popover="auto"
    role="group"
    aria-label={ui.appearance}
  >
    <fieldset>
      <legend>{ui.colorScheme}</legend>
      {
        schemes.map(({ value, label, icon }) => (
          <label>
            <input
              type="radio"
              name={`${id}-scheme`}
              value={value}
              data-appearance-scheme
              checked={value === "system"}
            />
            <Icon name={icon} />
            <span>{label}</span>
            <Icon name="approve-check" data-element="Checkmark" />
          </label>
        ))
      }
    </fieldset>
    <fieldset>
      <legend>{ui.contrast}</legend>
      {
        contrasts.map(({ value, label, icon }) => (
          <label>
            <input
              type="radio"
              name={`${id}-contrast`}
              value={value}
              data-appearance-contrast
              checked={value === "system"}
            />
            {icon === "auto" ? (
              <Icon name="laptop" />
            ) : (
              <ContrastIcon level={icon} />
            )}
            <span>{label}</span>
            <Icon name="approve-check" data-element="Checkmark" />
          </label>
        ))
      }
    </fieldset>
  </div>
</ThemeSelectRoot>

<script>
  import {
    APPEARANCE_KEY,
    LEGACY_THEME_KEY,
    loadPreferences,
    storePreferences,
    parseTheme,
    parseContrast,
  } from "../components/appearance-preferences.js";
  import { initializePopoverMotion } from "../client/popover-motion.js";

  let current = loadPreferences();
  const systemScheme = matchMedia("(prefers-color-scheme: light)");

  function applyPreferences(): void {
    document.documentElement.dataset.theme =
      current.theme === "system"
        ? systemScheme.matches
          ? "light"
          : "dark"
        : current.theme;
    if (current.contrast === "system") {
      delete document.documentElement.dataset.contrast;
    } else {
      document.documentElement.dataset.contrast = current.contrast;
    }
    document
      .querySelectorAll<HTMLInputElement>("[data-appearance-scheme]")
      .forEach((input) => {
        input.checked = input.value === current.theme;
      });
    document
      .querySelectorAll<HTMLInputElement>("[data-appearance-contrast]")
      .forEach((input) => {
        input.checked = input.value === current.contrast;
      });
  }

  systemScheme.addEventListener("change", () => {
    if (current.theme === "system") applyPreferences();
  });
  window.addEventListener("storage", (event) => {
    if (
      !event.key ||
      event.key === APPEARANCE_KEY ||
      event.key === LEGACY_THEME_KEY
    ) {
      current = loadPreferences();
      applyPreferences();
    }
  });

  class CookbookAppearanceMenu extends HTMLElement {
    connectedCallback(): void {
      if (this.dataset.ready) return;
      this.dataset.ready = "true";
      initializePopoverMotion(this.querySelector<HTMLElement>("[popover]")!);
      this.addEventListener("change", (event) => {
        const input = event.target;
        if (!(input instanceof HTMLInputElement)) return;
        if (input.hasAttribute("data-appearance-scheme")) {
          current.theme = parseTheme(input.value);
        } else if (input.hasAttribute("data-appearance-contrast")) {
          current.contrast = parseContrast(input.value);
        } else return;
        storePreferences(current);
        applyPreferences();
      });
      applyPreferences();
    }
  }

  if (!customElements.get("cookbook-appearance-menu")) {
    customElements.define("cookbook-appearance-menu", CookbookAppearanceMenu);
  }
</script>
