---
import { addHeadingPermalinks } from "../markdown/rendered-content.js";
import MarkdownStyles from "../components/MarkdownContent.styles.js";

const content = addHeadingPermalinks(await Astro.slots.render("default"));
---

<MarkdownStyles />
<div
  class="cookbook-markdown-content"
  data-tasty-anatomy="Markdown"
  set:html={content}
/>

<script>
  import { initializeHeadingLinks } from "../client/heading-links.js";

  initializeHeadingLinks();
  document.addEventListener("astro:page-load", initializeHeadingLinks);
</script>
