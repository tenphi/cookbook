---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { content, mdxLoaders } from "virtual:cookbook/config";
import { layout } from "virtual:cookbook/layout";
import { starlightPageSidebar } from "../navigation.js";

export const prerender = true;

export function getStaticPaths() {
  const entries = content.entries.filter(
    (entry) =>
      import.meta.env.MODE !== "production" || !entry.frontmatter.draft,
  );
  return [
    ...entries.map((entry) => ({
      params: { route: entry.route === "/" ? undefined : entry.route.slice(1) },
      props: { entry, routes: content.routes },
    })),
    ...Object.entries(content.redirects).flatMap(([alias, target]) => {
      const entry = entries.find((entry) => entry.route === target);
      return entry
        ? [
            {
              params: { route: alias === "/" ? undefined : alias.slice(1) },
              props: { entry, routes: content.routes, redirect: target },
            },
          ]
        : [];
    }),
  ];
}

const { entry, routes, redirect } = Astro.props;
if (redirect)
  return Astro.redirect(`${content.base.replace(/\/$/, "")}${redirect}`, 301);
const loadMdx = mdxLoaders[entry.route];
if (!entry.rendered && !loadMdx) {
  throw new Error(`Cookbook did not render ${entry.sourcePath}.`);
}
const mdx = loadMdx ? await loadMdx() : undefined;
const MdxContent = mdx?.default;
const headings = mdx?.getHeadings
  ? await mdx.getHeadings()
  : (entry.rendered?.headings ?? []);
const lastUpdated =
  typeof entry.frontmatter.lastUpdated === "string"
    ? new Date(entry.frontmatter.lastUpdated)
    : entry.frontmatter.lastUpdated;
const hero = starlightHero(entry.frontmatter.hero);
const frontmatter = {
  title: entry.title,
  ...(entry.description ? { description: entry.description } : {}),
  ...(entry.frontmatter.tableOfContents !== undefined
    ? { tableOfContents: entry.frontmatter.tableOfContents }
    : {}),
  ...(entry.frontmatter.editUrl !== undefined
    ? { editUrl: entry.frontmatter.editUrl }
    : {}),
  ...(entry.frontmatter.template !== undefined
    ? { template: entry.frontmatter.template }
    : {}),
  ...(hero !== undefined ? { hero } : {}),
  ...(lastUpdated !== undefined ? { lastUpdated } : {}),
  ...(entry.frontmatter.prev !== undefined
    ? { prev: entry.frontmatter.prev }
    : {}),
  ...(entry.frontmatter.next !== undefined
    ? { next: entry.frontmatter.next }
    : {}),
  ...(entry.frontmatter.banner !== undefined
    ? { banner: entry.frontmatter.banner }
    : {}),
  ...(entry.frontmatter.pagefind !== undefined
    ? { pagefind: entry.frontmatter.pagefind }
    : {}),
  ...(entry.frontmatter.head ? { head: entry.frontmatter.head } : {}),
  ...(entry.frontmatter.draft ? { draft: true } : {}),
};

function starlightHero(value: typeof entry.frontmatter.hero) {
  const image = value?.image;
  if (!value || !image || "html" in image) return value;
  if ("file" in image) {
    return {
      ...value,
      image: { ...image, file: imageMetadata(image.file) },
    };
  }
  return {
    ...value,
    image: {
      ...image,
      dark: imageMetadata(image.dark),
      light: imageMetadata(image.light),
    },
  };
}

function imageMetadata(src: string) {
  const pathname = src.split(/[?#]/, 1)[0] ?? src;
  const extension = /\.(avif|gif|jpe?g|png|svg|webp)$/i.exec(pathname)?.[1];
  const format = extension?.toLowerCase().replace("jpg", "jpeg") ?? "png";
  return { src, width: 400, height: 400, format };
}
---

<StarlightPage
  frontmatter={frontmatter}
  headings={headings}
  sidebar={starlightPageSidebar(layout, routes)}
>
  {MdxContent ? <MdxContent /> : <div set:html={entry.rendered?.html ?? ""} />}
</StarlightPage>
