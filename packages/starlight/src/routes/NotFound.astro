---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { content } from "virtual:cookbook/config";
import { layout } from "virtual:cookbook/layout";
import { localizedNavigation, messages } from "../localization.js";
import { starlightPageSidebar } from "../navigation.js";

export const prerender = true;
const navigation = localizedNavigation(layout, content.routes, "/404", content);
const ui = messages(content.locales?.root?.lang ?? "en", content);
---

<StarlightPage
  frontmatter={{ title: ui.notFound, pagefind: false }}
  headings={[]}
  sidebar={starlightPageSidebar(navigation.layout, navigation.routes)}
>
  <p>{ui.notFoundDescription}</p>
</StarlightPage>
