---
import { messages } from "../localization.js";
import { content } from "virtual:cookbook/config";
import { PackageVersionRoot } from "./LayoutComponents.js";

interface Props {
  version?: string;
}

const version = Astro.props.version?.trim();
const label = version?.startsWith("v") ? version : version ? `v${version}` : "";
const ui = messages(Astro.locals.starlightRoute?.lang ?? "en", content);
---

{
  label && (
    <PackageVersionRoot
      className="td-package-version"
      aria-label={`${ui.version} ${version}`}
      data-tasty-anatomy="PackageVersion"
    >
      {label}
    </PackageVersionRoot>
  )
}
