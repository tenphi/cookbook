---
import { messages } from "../localization.js";
import { content } from "virtual:cookbook/config";
import type { DocsRoute, SiteVersion } from "@tenphi/docs";
import { versionLinks } from "../versioning.js";
import { VersionSwitcherRoot } from "./LayoutComponents.js";

interface Props {
  versions: SiteVersion[];
  routes: DocsRoute[];
  currentPath: string;
  base: string;
}

const { current, links } = versionLinks(
  Astro.props.versions,
  Astro.props.routes,
  Astro.props.currentPath,
  Astro.props.base,
  content,
);
const ui = messages(Astro.locals.starlightRoute?.lang ?? "en", content);
---

<VersionSwitcherRoot data-tasty-anatomy="VersionSwitcher">
  <summary
    aria-label={`${ui.documentationVersion}: ${current?.label ?? ui.versions}`}
    >{current?.label ?? ui.versions}</summary
  >
  <nav aria-label={ui.documentationVersions}>
    {
      links.map((version) => (
        <a
          href={version.href}
          aria-current={
            version.routeBase === current?.routeBase ? "page" : undefined
          }
        >
          {version.label}
        </a>
      ))
    }
  </nav>
</VersionSwitcherRoot>
