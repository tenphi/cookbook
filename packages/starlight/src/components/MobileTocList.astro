---
interface Item {
  slug: string;
  text: string;
  children: Item[];
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<ul>
  {
    items.map((item) => (
      <li>
        <a href={`#${item.slug}`}>{item.text}</a>
        {item.children.length > 0 && <Astro.self items={item.children} />}
      </li>
    ))
  }
</ul>
