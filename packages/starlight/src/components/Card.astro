---
import { CardLink, CardRoot } from "./TastyComponents.js";

import type { CardProps as Props } from "./props.js";

const { title, href } = Astro.props;
const Root = href ? CardLink : CardRoot;
---

<Root className="td-card" href={href} data-tasty-anatomy="Card">
  {title && <h3 data-tasty-anatomy="CardTitle">{title}</h3>}
  <div data-tasty-anatomy="CardBody"><slot /></div>
</Root>
