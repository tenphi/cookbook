---
import {
  localizedNavigation,
  localePath,
  localeHref,
} from "../localization.js";
import { messages } from "../localization.js";
import { content } from "virtual:cookbook/config";
import Icon from "@astrojs/starlight/user-components/Icon.astro";
import Logo from "../components/SiteLogo.astro";
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter";
import { layout as configuredLayout } from "virtual:cookbook/layout";
import SidebarList from "../components/SidebarList.astro";
import MobileNavigationTabs from "../components/MobileNavigationTabs.astro";
import { activeNavigationTab, navigationPath } from "../navigation.js";

const fullSidebar = Astro.locals.starlightRoute.sidebar;
const currentPath = navigationPath(
  Astro.url.pathname,
  import.meta.env.BASE_URL,
);
const { layout } = localizedNavigation(
  configuredLayout,
  content.routes,
  currentPath,
  content,
);
const activeTab = activeNavigationTab(
  layout.tabs,
  localePath(currentPath, content),
);
const groupIndex =
  (activeTab >= 0 ? layout.tabs[activeTab]?.sidebarGroup : undefined) ??
  layout.fallbackSidebarGroup;
const selectedGroup = layout.sectioned
  ? groupIndex === undefined
    ? undefined
    : fullSidebar[groupIndex]
  : undefined;
const sidebar =
  selectedGroup?.type === "group"
    ? selectedGroup.entries
    : layout.sectioned
      ? []
      : fullSidebar;
const ui = messages(Astro.locals.starlightRoute?.lang ?? "en", content);
---

<div class="td-sidebar-heading">
  <a
    class="td-sidebar-heading__home"
    href={localeHref(
      (content.logo && content.logo.href) || "/",
      currentPath,
      content.routes,
      content,
      content.base,
    )}
  >
    <Logo />
    <span data-site-title>{Astro.locals.starlightRoute.siteTitle}</span>
  </a>
  <button
    type="button"
    popovertarget="starlight__sidebar"
    popovertargetaction="hide"
    aria-label={ui.closeNavigation}
    autofocus><Icon name="close" /></button
  >
</div>

<MobileNavigationTabs
  base={import.meta.env.BASE_URL}
  currentPath={Astro.url.pathname}
/>

<cookbook-sidebar
  data-storage-key={`cookbook-sidebar:${import.meta.env.BASE_URL}:${groupIndex ?? "all"}`}
>
  <SidebarList entries={sidebar} />
</cookbook-sidebar>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<script>
  import "../client/sidebar.js";
</script>
