---
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter";
import { layout } from "virtual:cookbook/layout";
import SidebarList from "../components/SidebarList.astro";
import MobileNavigationTabs from "../components/MobileNavigationTabs.astro";
import { activeNavigationTab, navigationPath } from "../navigation.js";

const fullSidebar = Astro.locals.starlightRoute.sidebar;
const currentPath = navigationPath(
  Astro.url.pathname,
  import.meta.env.BASE_URL,
);
const activeTab = activeNavigationTab(layout.tabs, currentPath);
const groupIndex =
  (activeTab >= 0 ? layout.tabs[activeTab]?.sidebarGroup : undefined) ??
  layout.fallbackSidebarGroup;
const selectedGroup = layout.sectioned
  ? groupIndex === undefined
    ? undefined
    : fullSidebar[groupIndex]
  : undefined;
const sidebar =
  selectedGroup?.type === "group"
    ? selectedGroup.entries
    : layout.sectioned
      ? []
      : fullSidebar;
---

<MobileNavigationTabs
  base={import.meta.env.BASE_URL}
  currentPath={Astro.url.pathname}
/>

<cookbook-sidebar
  data-storage-key={`cookbook-sidebar:${import.meta.env.BASE_URL}:${groupIndex ?? "all"}`}
>
  <SidebarList entries={sidebar} />
</cookbook-sidebar>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<script>
  class CookbookSidebar extends HTMLElement {
    connectedCallback() {
      const key = this.dataset.storageKey!;
      const groups = this.querySelectorAll<HTMLDetailsElement>(
        "details[data-sidebar-group]",
      );
      const scroller = this.closest<HTMLElement>("#starlight__sidebar");
      try {
        const saved = JSON.parse(sessionStorage.getItem(key) || "{}");
        for (const group of groups) {
          // Always reveal the current page, even if its branch was closed before.
          if (group.querySelector('[aria-current="page"]')) group.open = true;
          else if (typeof saved?.[group.dataset.sidebarGroup!] === "boolean") {
            group.open = saved[group.dataset.sidebarGroup!];
          }
        }
        if (scroller && matchMedia("(min-width: 50em)").matches) {
          scroller.scrollTop =
            Number(sessionStorage.getItem(`${key}:scroll`)) || 0;
        }
      } catch {
        // Native disclosures still work when session storage is unavailable.
      }
      for (const group of groups) {
        group.addEventListener("toggle", () => {
          try {
            sessionStorage.setItem(
              key,
              JSON.stringify(
                Object.fromEntries(
                  Array.from(groups, (item) => [
                    item.dataset.sidebarGroup!,
                    item.open,
                  ]),
                ),
              ),
            );
          } catch {
            // Remembering expansion is optional.
          }
        });
      }
      scroller?.addEventListener(
        "scroll",
        () => {
          try {
            sessionStorage.setItem(`${key}:scroll`, String(scroller.scrollTop));
          } catch {
            // Scroll restoration is optional too.
          }
        },
        { passive: true },
      );
    }
  }
  if (!customElements.get("cookbook-sidebar")) {
    customElements.define("cookbook-sidebar", CookbookSidebar);
  }
</script>
