---
import Icon from "@astrojs/starlight/user-components/Icon.astro";
import paletteIcon from "../icons/palette.svg?raw";
import ContrastIcon from "../components/ContrastIcon.astro";
import { ThemeSelectRoot } from "../components/LayoutComponents.js";

const id = `appearance-${crypto.randomUUID()}`;
const schemes = [
  { value: "light", label: Astro.locals.t("themeSelect.light"), icon: "sun" },
  { value: "dark", label: Astro.locals.t("themeSelect.dark"), icon: "moon" },
  { value: "auto", label: Astro.locals.t("themeSelect.auto"), icon: "laptop" },
] as const;
const contrasts = [
  { value: "normal", label: "Normal", icon: "normal" },
  { value: "more", label: "High", icon: "more" },
  { value: "system", label: "Auto", icon: "auto" },
] as const;
---

<ThemeSelectRoot data-tasty-anatomy="ThemeSelect">
  <button
    type="button"
    popovertarget={id}
    aria-label="Appearance"
    title="Appearance"
  >
    <span aria-hidden="true" set:html={paletteIcon} />
  </button>
  <div id={id} popover="auto" role="group" aria-label="Appearance">
    <fieldset>
      <legend>Color scheme</legend>
      {
        schemes.map(({ value, label, icon }) => (
          <label>
            <input
              type="radio"
              name={`${id}-scheme`}
              value={value}
              data-appearance-scheme
              checked={value === "auto"}
            />
            <Icon name={icon} />
            <span>{label}</span>
            <Icon name="approve-check" class="checkmark" />
          </label>
        ))
      }
    </fieldset>
    <fieldset>
      <legend>Contrast</legend>
      {
        contrasts.map(({ value, label, icon }) => (
          <label>
            <input
              type="radio"
              name={`${id}-contrast`}
              value={value}
              data-appearance-contrast
              checked={value === "system"}
            />
            {icon === "auto" ? (
              <Icon name="laptop" />
            ) : (
              <ContrastIcon level={icon} />
            )}
            <span>{label}</span>
            <Icon name="approve-check" class="checkmark" />
          </label>
        ))
      }
    </fieldset>
  </div>
</ThemeSelectRoot>

<script>
  import {
    loadPreferences,
    storePreferences,
    parseScheme,
    parseContrast,
  } from "../components/appearance-preferences.js";

  let current = loadPreferences();
  const systemScheme = matchMedia("(prefers-color-scheme: light)");

  function applyPreferences(): void {
    document.documentElement.dataset.theme =
      current.scheme === "auto"
        ? systemScheme.matches
          ? "light"
          : "dark"
        : current.scheme;
    if (current.contrast === "system") {
      delete document.documentElement.dataset.contrast;
    } else {
      document.documentElement.dataset.contrast = current.contrast;
    }
    document
      .querySelectorAll<HTMLInputElement>("[data-appearance-scheme]")
      .forEach((input) => {
        input.checked = input.value === current.scheme;
      });
    document
      .querySelectorAll<HTMLInputElement>("[data-appearance-contrast]")
      .forEach((input) => {
        input.checked = input.value === current.contrast;
      });
  }

  systemScheme.addEventListener("change", () => {
    if (current.scheme === "auto") applyPreferences();
  });
  window.addEventListener("storage", (event) => {
    if (
      !event.key ||
      ["starlight-theme", "cookbook-appearance"].includes(event.key)
    ) {
      current = loadPreferences();
      applyPreferences();
    }
  });

  class CookbookAppearanceMenu extends HTMLElement {
    connectedCallback(): void {
      if (this.dataset.ready) return;
      this.dataset.ready = "true";
      this.addEventListener("change", (event) => {
        const input = event.target;
        if (!(input instanceof HTMLInputElement)) return;
        if (input.hasAttribute("data-appearance-scheme")) {
          current.scheme = parseScheme(input.value);
        } else if (input.hasAttribute("data-appearance-contrast")) {
          current.contrast = parseContrast(input.value);
        } else return;
        storePreferences(current);
        applyPreferences();
      });
      applyPreferences();
    }
  }

  if (!customElements.get("cookbook-appearance-menu")) {
    customElements.define("cookbook-appearance-menu", CookbookAppearanceMenu);
  }
</script>
