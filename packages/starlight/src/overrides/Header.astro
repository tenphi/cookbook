---
import config from "virtual:starlight/user-config";
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import MobileMenuToggle from "virtual:starlight/components/MobileMenuToggle";
import HeaderLinks from "../components/HeaderLinks.astro";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import { content } from "virtual:cookbook/config";
import { layout } from "virtual:cookbook/layout";
import { activeNavigationTab, navigationPath } from "../navigation.js";
import GlobalStyles from "../components/GlobalStyles.js";
import Logo from "../components/Logo.astro";
import PackageVersion from "../components/PackageVersion.astro";
import {
  StarlightHeaderRoot,
  TopNavigationRoot,
} from "../components/LayoutComponents.js";

const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== "@astrojs/starlight/components/Search.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = navigationPath(Astro.url.pathname, base || "/");
const activeTab = activeNavigationTab(layout.tabs, currentPath);
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;

function tabHref(link: string): string {
  return link.startsWith("/") ? `${base}${link}` || "/" : link;
}
---

<GlobalStyles />
<StarlightHeaderRoot
  className={`td-header${layout.tabs.length ? " td-header--with-tabs" : ""}`}
  data-tasty-anatomy="StarlightHeader"
  data-has-sidebar={Astro.locals.starlightRoute.hasSidebar ? "" : undefined}
>
  <div class="td-header__primary">
    <div class="td-header__title">
      <a
        class="td-header__logo-link"
        href={siteTitleHref}
        aria-label={`${siteTitle} home`}
      >
        <Logo class="td-header__logo" decorative />
      </a>
      <SiteTitle />
      <PackageVersion version={content.site.version} />
    </div>
    <div class="td-header__search print:hidden">
      {shouldRenderSearch && <Search />}
    </div>
    <HeaderLinks />
    <div class="td-header__mobile-theme md:sl-hidden print:hidden">
      <ThemeSelect />
    </div>
    <div class="td-header__tools sl-hidden md:sl-flex print:hidden">
      <div class="td-header__social"><SocialIcons /></div>
      <ThemeSelect />
      <LanguageSelect />
    </div>
  </div>
  {
    layout.tabs.length > 0 && (
      <TopNavigationRoot
        className="td-top-tabs print:hidden"
        aria-label="Primary"
        data-tasty-anatomy="TopNavigation"
      >
        {layout.tabs.map((tab, index) => (
          <a
            href={tabHref(tab.link)}
            aria-current={index === activeTab ? "page" : undefined}
          >
            {tab.label}
          </a>
        ))}
      </TopNavigationRoot>
    )
  }
  {Astro.locals.starlightRoute.hasSidebar && <MobileMenuToggle />}
</StarlightHeaderRoot>

<script src="../client/code-copy.js"></script>
