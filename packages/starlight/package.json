{
  "name": "@tenphi/starlight",
  "version": "0.17.0",
  "description": "Astro and Starlight renderer for Cookbook",
  "type": "module",
  "sideEffects": [
    "./dist/client/*.js",
    "./dist/styling.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components-public.d.ts",
      "import": "./dist/components.js"
    },
    "./styling": {
      "types": "./dist/styling.d.ts",
      "import": "./dist/styling.js"
    },
    "./eslint-plugin": {
      "types": "./dist/eslint-plugin.d.ts",
      "import": "./dist/eslint-plugin.js"
    },
    "./client/*": "./dist/client/*.js"
  },
  "files": [
    "dist",
    "tasty.config.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts && node ../../scripts/pack-assets.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenphi/cookbook.git",
    "directory": "packages/starlight"
  },
  "homepage": "https://github.com/tenphi/cookbook#readme",
  "bugs": {
    "url": "https://github.com/tenphi/cookbook/issues"
  },
  "author": "Andrey Yamanov",
  "license": "MIT",
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/react": "^6.0.5",
    "@astrojs/starlight": "catalog:",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.0",
    "@tenphi/docs": "workspace:*",
    "@tenphi/eslint-plugin-tasty": "1.1.0",
    "@tenphi/glaze": "catalog:",
    "@tenphi/tasty": "catalog:",
    "beautiful-mermaid": "^1.1.3",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "sharp": "0.35.4"
  },
  "peerDependencies": {
    "astro": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "@types/react": "^19.2.18",
    "astro": "catalog:",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
