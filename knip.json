{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["scripts/fixtures/**"],
  "workspaces": {
    "apps/convention": {
      "entry": ["docs/FixtureLabel.astro"]
    },
    "apps/reference": {
      "entry": ["docs.config.ts"]
    },
    "packages/facade": {
      "entry": [
        "tasty.config.mjs",
        "type-tests/index.ts",
        "harness/dev.harnesspm/theme.mjs"
      ],
      "ignoreDependencies": [
        "@tenphi/eslint-plugin-tasty",
        "@tenphi/glaze",
        "@tenphi/tasty"
      ]
    },
    "packages/renderer": {
      "entry": ["tasty.config.mjs"]
    },
    ".": {
      "entry": ["scripts/browser-site.mjs"]
    }
  },
  "ignoreDependencies": [
    "@arethetypeswrong/cli",
    "@astrojs/react",
    "publint",
    "unrun",
    "@astrojs/markdown-remark"
  ]
}
